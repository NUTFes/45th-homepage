{
  "name": "45th-homepage",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/subset-font.cjs && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "quality:check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "next typegen && tsc --noEmit",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1023.0",
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-s3": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@tailwindcss/postcss": "^4.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "graphql": "^16.14.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "payload": "3.84.1",
    "postcss": "^8.5.14",
    "react": "19.2.6",
    "react-aria": "^3.47.0",
    "react-aria-components": "^1.16.0",
    "react-dom": "19.2.6",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "lefthook": "^2.1.4",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0",
    "subset-font": "2.5.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "pino": "9.13.1"
    }
  }
}
