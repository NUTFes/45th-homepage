# Required in all modes
PAYLOAD_SECRET=replace_with_long_random_secret
CLOUDFLARE_TUNNEL_TOKEN=replace_with_tunnel_token
NEXT_PUBLIC_SITE_URL=replace_with_site_url

# Contact form
SLACK_CONTACT_WEBHOOK_URL=replace_with_slack_incoming_webhook_url
# Comma-separated Slack member IDs to mention in addition to @channel.
SLACK_CONTACT_QUESTION_USER_IDS=
SLACK_CONTACT_SPONSOR_USER_IDS=
SLACK_CONTACT_BOOTH_USER_IDS=
SLACK_CONTACT_LOST_FOUND_USER_IDS=
SLACK_CONTACT_OTHER_USER_IDS=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=appdb

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# SeaweedFS weed mini (for media storage)
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret_key
S3_BUCKET=media
S3_ENDPOINT=http://seaweedfs-s3:8333
S3_REGION=us-east-1

# Required: strict health check requires this header value
# x-health-key: <HEALTH_CHECK_KEY>
HEALTH_CHECK_KEY=replace_with_healthcheck_key
